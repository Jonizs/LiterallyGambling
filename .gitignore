node_modules/
.env

# Ruflo local secrets and runtime data
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
.claude-flow/daemon.pid
.claude-flow/daemon-state.json
.claude-flow/harness-active-policy.json
.claude-flow/policy/
.claude-flow/metrics/codebase-map.json
.claude-flow/metrics/performance.json
.claude-flow/metrics/security-audit.json
.claude/.proven-config-version
.claude/proven-config.json
.claude-flow/metrics/backup.json
.claude-flow/metrics/consolidation.json
.claude-flow/metrics/harness-loop.json
.claude-flow/metrics/test-gaps.json
.swarm/backups/
.swarm/memory.db-shm
.swarm/memory.db-wal

# Ruflo generates these per machine — statusline.cjs bakes in a
# machine-specific install path — so every environment rewrites them and
# they churn on every session. The rest of .claude/helpers stays tracked.
.claude/helpers/.helpers-version
.claude/helpers/helpers.manifest.json
.claude/helpers/statusline.cjs
.claude/helpers/hook-handler.cjs
.claude/helpers/intelligence.cjs
.claude/helpers/auto-memory-hook.mjs
